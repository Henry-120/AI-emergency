# Frontend
VITE_BACKEND_URL=http://localhost:8000
VITE_NATIVE_BACKEND_URL=http://YOUR_LAN_IP:8000

# FastAPI backend / Firebase Admin
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
AUTH_SECRET=replace-with-a-long-random-secret
CWA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
SOS_KEY_VERSION=1
SOS_ENCRYPTION_PRIVATE_KEY_PEM=
SOS_ACK_SIGNING_PRIVATE_KEY_PEM=
# Cloud Run request-based billing should keep this false; use Cloud Scheduler instead.
ENABLE_PUSH_POLLING=false
